{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astralayering.local/schema/expression-workflow-0.2.json",
  "title": "Astra facial boundary authoring agent workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "id",
    "inputs",
    "resources",
    "models",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "document_type": {
      "const": "expression_workflow"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "required",
          "description"
        ],
        "properties": {
          "type": {
            "enum": [
              "file",
              "text"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "reasoning_effort"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource"
          ],
          "properties": {
            "resource": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact"
          ],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "type": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "description": {
          "type": "string"
        },
        "required_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema"
            ],
            "properties": {
              "schema": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "capability_profile": {
                "const": "basic-face-v1"
              }
            }
          }
        }
      }
    },
    "argument": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output"
          ],
          "properties": {
            "output": {
              "$ref": "#/$defs/id"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "needs",
        "inputs",
        "outputs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "tool",
            "review"
          ]
        },
        "description": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/reference"
          }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/output"
          }
        },
        "model": {
          "$ref": "#/$defs/id"
        },
        "session": {
          "$ref": "#/$defs/id"
        },
        "prompt": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "entry",
            "args"
          ],
          "properties": {
            "runtime": {
              "enum": [
                "node",
                "python3"
              ]
            },
            "entry": {
              "$ref": "#/$defs/id"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/argument"
              }
            }
          }
        },
        "report": {
          "$ref": "#/$defs/id"
        },
        "coverage": {
          "description": "Require an independent visual observation for each actual scanner visual case before a review can pass.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report_input"
          ],
          "properties": {
            "report_input": {
              "$ref": "#/$defs/id"
            },
            "capability_profile": {
              "const": "basic-face-v1"
            },
            "controls_input": {
              "$ref": "#/$defs/id"
            }
          },
          "dependentRequired": {
            "capability_profile": [
              "controls_input"
            ],
            "controls_input": [
              "capability_profile"
            ]
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_rounds"
          ],
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_rounds",
            "targets"
          ],
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "model"
                  ]
                },
                {
                  "required": [
                    "session"
                  ]
                },
                {
                  "required": [
                    "report"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "model",
              "session",
              "prompt"
            ],
            "not": {
              "required": [
                "command"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "review"
              }
            }
          },
          "then": {
            "required": [
              "report",
              "repair"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "report"
                  ]
                },
                {
                  "required": [
                    "coverage"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
