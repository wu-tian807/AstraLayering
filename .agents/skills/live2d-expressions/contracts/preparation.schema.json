{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "prepared_sha256",
    "changes",
    "added_ids",
    "protected_ids_verified",
    "hidden_material_coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prepared_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "svg_id",
          "reason",
          "kind"
        ],
        "properties": {
          "svg_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "initial_pose",
              "missing_material",
              "structural_separation",
              "clip",
              "id_assignment"
            ]
          }
        }
      },
      "maxItems": 0
    },
    "added_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "protected_ids_verified": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "hidden_material_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
