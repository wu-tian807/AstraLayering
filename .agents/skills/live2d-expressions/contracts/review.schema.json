{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "verdict",
    "summary",
    "evidence",
    "issues",
    "limitations",
    "checked_cases",
    "continuous_review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "task_id": {
      "const": "review_boundaries"
    },
    "verdict": {
      "enum": [
        "pass",
        "revise",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "code",
          "description",
          "parameters",
          "svg_ids",
          "evidence",
          "suggested_change"
        ],
        "properties": {
          "target": {
            "enum": [
              "author_boundaries"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "svg_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "suggested_change": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checked_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parameters",
          "image",
          "result",
          "observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "revise"
            ]
          },
          "observations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "neutral_fidelity",
              "eyelid_contact",
              "lash_preservation",
              "neighborhood_follow",
              "mouth_contour",
              "aperture_mask",
              "usable_range",
              "eye_curve",
              "brow_shape"
            ],
            "properties": {
              "neutral_fidelity": {
                "type": "string",
                "minLength": 1
              },
              "eyelid_contact": {
                "type": "string",
                "minLength": 1
              },
              "lash_preservation": {
                "type": "string",
                "minLength": 1
              },
              "neighborhood_follow": {
                "type": "string",
                "minLength": 1
              },
              "mouth_contour": {
                "type": "string",
                "minLength": 1
              },
              "aperture_mask": {
                "type": "string",
                "minLength": 1
              },
              "usable_range": {
                "type": "string",
                "minLength": 1
              },
              "eye_curve": {
                "type": "string",
                "minLength": 1
              },
              "brow_shape": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "continuous_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "parameter_ids",
        "evidence",
        "observations"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "parameter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability_profile": {
      "const": "basic-face-v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          },
          "checked_cases": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "pass"
                }
              }
            }
          },
          "continuous_review": {
            "properties": {
              "performed": {
                "const": true
              },
              "parameter_ids": {
                "minItems": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "revise"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
