            },
            "minItems": 2,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 3
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "x"
      ],
      "properties": {
        "kind": {
          "enum": [
            "aperture",
            "seam",
            "curve"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "aperture": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "seam"
              }
            }
          },
          "then": {
            "required": [
              "aperture"
            ]
          },
          "else": {
            "not": {
              "required": [
                "aperture"
              ]
            }
          }
        }
      ]
    },
    "keyform": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "identity"
          ],
          "properties": {
            "at": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 3
            },
            "identity": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "upper",
            "lower"
          ],
          "properties": {
            "at": {
              "type": "array",
