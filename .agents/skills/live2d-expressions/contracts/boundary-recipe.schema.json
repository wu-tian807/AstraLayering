          "additionalProperties": false,
          "required": [
            "at",
            "curve"
          ],
          "properties": {
            "at": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 3
            },
            "curve": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "curve_mode": {
              "enum": [
                "absolute",
                "offset"
              ],
              "default": "absolute"
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "role"
