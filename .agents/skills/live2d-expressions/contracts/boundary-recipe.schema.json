          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "dependentRequired": {
        "anchor": [
          "mode"
        ],
        "key_offsets": [
          "mode"
        ]
      },
      "dependentSchemas": {
        "subdivisions": {
          "not": {
            "required": [
              "mode"
            ]
          }
        }
      }
    },
    "paint": {
