{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astralayering.local/schema/boundary-recipe-0.3.json",
  "title": "Astra SVG authored boundary recipe 0.3",
  "$comment": "Runtime/compiler also validate cross-field axis coverage, keyform products, source hashes, transforms, actual SVG ownership and path topology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "character_id",
    "source_sha256",
    "parameters",
    "regions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "document_type": {
      "const": "boundary_recipe"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0
    },
    "subdivisions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 4
    },
    "capability_profile": {
      "const": "basic-face-v1",
      "description": "Optional for generic/legacy partial rigs; mandatory for the standard facial workflow."
    }
  },
  "$defs": {
