      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "min",
        "max",
        "default"
      ],
      "properties": {
        "type": {
          "const": "number"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter",
          "keys"
