# 默认模型配置的唯一来源：启动器创建 .env、运行时回退与 WebUI 默认展示均读取本文件。
# 方案 1（默认）：全 gpt-6.1-sol，按职责配置力度；生图继承 Codex 内置工具。
# 新安装直接以本文件创建 .env；方案 2 在此基础上叠加 presets/optimized.env。已有 .env 不整份覆盖。
# shell 配置优先于 .env；同一来源内统一键优先于旧别名。不执行 shell 或展开变量。
# 模型枚举：gpt-6.1-sol / gpt-6-astra -> codex；claude-sonnet-5-5 / claude-opus-5-5 / claude-haiku-5-5 -> claude；gemini-4-argon -> agv。
# 最后一个后缀是思考力度：low / medium / high / xhigh。留空使用对应职责默认值。
# LLM 按职责配置，人物和衣服共用；生图按实际拥有工具的 agent 分别配置。
# Nano 透明后处理使用已有 Node／Sharp 双背景差分，不安装 Python 包或抠图模型。
# Python 优先复用宿主已有环境；缺少时由启动 agent 验证 Krita 内置脚本环境。

# 三种主模型 CLI 共用 key / URL / models；与下方生图接口分别鉴权。
# 连接字段留空复用已有登录／provider。Codex、Claude 只填 key 使用官方地址；AGV 需同时填 key 和 URL。
# models 是逗号分隔的可用模型 ID 列表，不带力度后缀；留空不限制，具体步骤仍由 layering_agent_<职责>_model 选择。
# Codex 保留宿主模型元数据；Claude 写入请求私有 modelPicker；AGV 转成原生网关模型列表。均不改用户全局配置。
layering_codex_api_key=
layering_codex_base_url=
layering_codex_models=
layering_claude_api_key=
layering_claude_base_url=
layering_claude_models=
layering_agv_api_key=
layering_agv_base_url=
layering_agv_models=
# genai / openai；统一连接留空默认 genai。openai 暂不支持本项目的 AGV 图片容量保护。
layering_agv_protocol=
# 例如 layering_codex_models=gpt-6.1-sol,gpt-6-astra；layering_claude_models=claude-sonnet-5-5,claude-opus-5-5。
# 旧 layering_custom_provider=true + layering_provider_base_url/api_key、ANTHROPIC_API_KEY/BASE_URL、
# AGY_LLM_GATEWAY_API_KEY/URL/MODELS/WIRE_PROTOCOL 仍兼容；新配置使用上面的统一键。

# 可选 CLI 绝对路径或相对 skill 的路径。Claude / agv 留空仅查找全局 PATH；不会自动安装。
layering_codex_path=
layering_codex_home=
layering_claude_path=
# true 时在首次使用 AGV 前自动准备补丁副本，取消原 CLI 60 秒的响应头期限，默认关闭；不安装 CLI，不需要 Rust。
layering_agv_unlimited_response_header_timeout=false
# 原始 CLI 路径；也兼容已有 patch:agv 返回的受控入口。
# CLI 自动更新开关使用 true（不能使用 1）；不兼容或开关未生效会明确报错。
layering_agv_path=
# 自定义 GenAI 网关拒绝 CLI 发出的 MINIMAL 时，可显式兼容为 LOW；默认留空，不修改任何力度。
# 仅替换 MINIMAL；支持 MINIMAL 的供应商保持留空。不会修改已经是 LOW / MEDIUM / HIGH 的请求。
layering_agv_minimal_thinking_level=

# 仅 Codex：按当前上下文图片数 compact，留空关闭；如上游最多 50 张，可填 49。
# 按图片数压缩和 Codex 自定义生图启用时自动构建共用补丁；layering_codex_path 留空即可。
# 缺 Rust 1.95.0 时自动在临时目录安装并在构建后清理；仍需 Git 和平台 C/C++ 编译依赖。
# 构建进度每 20～30 秒写入工作流日志；3 分钟无输出会提示可能的网络问题与处理办法，不会自动中止。
# 显式填写 layering_codex_path 时只校验该入口，不替换用户指定的二进制。
# 安装补丁本身不启用保护；pnpm env:check 检查生效值。换模型方案时保留已配置的阈值。
layering_image_compact_threshold=

# 各接口独立的图片数／实际 JSON 请求体预算；留空关闭，不改变上游硬限制。
# Codex 专用阈值优先于旧 layering_image_compact_threshold；按字节压缩需要新补丁 request_compaction_version: 1。
# 数量达到阈值或最终请求大小达到预算时带图 compact；溢出时每批也受同样预算约束。
layering_codex_image_compact_threshold=
layering_codex_request_compact_mib=
layering_claude_image_compact_threshold=
layering_claude_request_compact_mib=
layering_agv_image_compact_threshold=
layering_agv_request_compact_mib=
# 例如已确认 AGV 上游 100 MiB 时可填 80；Claude 官方 Messages 32 MB 时可填 28。
# AGV 保护需要已配置的 genai 网关；Claude 支持原生 Messages 路由，保留原鉴权和原生自动压缩。
# 可选无损去重默认关闭：匹配图片字节及来源／裁剪／倍率／模式，保留最新原图与所有文字／调用记录。
layering_agv_image_deduplicate=false
layering_claude_image_deduplicate=false

# 本机同时运行的 section Krita 上限，跨任务计算，须为正整数。需要 Krita 的 section 在动手前占一个名额并持有到
# section 结束；名额用满时在进入该 section 前排队，不需要 Krita 的 section 不占名额，也不给 agent krita 工具。
layering_krita_max_instances=4

# 工作台每天最多查询一次 GitHub 最新发布标签，有新版本时在标题栏提示；只提示，不下载、不替换文件。
# false 关闭；留空或 true 开启。不影响任何制作步骤。
layering_update_check=true

# preparation 的全部 agent：姿态／画风判断、标准化、简化、素体和纯衣服准备。
layering_agent_preparation_model=gpt-6.1-sol-low

# 两套 part 共用。返修沿用绘制模型，首次分组与细分组共用，深度分析单独配置。
layering_agent_part_draw_model=gpt-6.1-sol-medium
layering_agent_part_review_model=gpt-6.1-sol-medium
layering_agent_part_reduce_model=gpt-6.1-sol-high
layering_agent_part_completion_model=gpt-6.1-sol-high
layering_agent_part_groups_model=gpt-6.1-sol-high
layering_agent_part_depth_model=gpt-6.1-sol-high
# SVG 合并由程序完成，不配置 LLM。

# 两套 raster 共用。step01 reviewer 独立配置，返修沿用 step01；step03 仅人物有。
layering_agent_raster_step01_model=gpt-6.1-sol-xhigh
layering_agent_raster_step02_model=gpt-6.1-sol-medium
layering_agent_raster_step01_review_model=gpt-6.1-sol-xhigh
layering_agent_raster_step03_model=gpt-6.1-sol-medium

# 后续人物与衣服组装仍独立配置。
layering_agent_assembly_model=gpt-6.1-sol-xhigh
# 投影蒙版与法线／深度共用阴影制作职责。
layering_agent_shadow_model=gpt-6.1-sol-medium

# 生图模型枚举：codex-native / gpt-image-2.5-sunburst / gpt-image-2.5-flare / gemini-nano-banana-2.1。
# Nano 透明请求内部串行生图两次（首次生成、仅换背景），由 Sharp 差分恢复 alpha；不安装抠图模型。
# codex-native 直接继承宿主 imagegen，不启用生图补丁；仅能与 Codex 模型配对。
# Codex 选择 GPT / Nano 并填写对应 API 时统一走补丁版原生 imagegen；未指定路径时自动构建。
# Claude / AGV 选择 GPT / Nano 时注册共享 imagegen 工具，不需要 Codex 补丁。
# 每个拥有生图工具的 agent 可以单独选择，不合并人物与衣服的生图配置；留空继承默认。
layering_default_image_model=codex-native
layering_part_standardize_image_model=
layering_part_simplify_image_model=
layering_part_base_subject_image_model=
layering_clothing_preparation_image_model=
layering_part_completion_image_model=
layering_clothing_completion_image_model=
layering_raster_step01_image_model=
layering_raster_step02_image_model=
layering_raster_step01_review_image_model=
layering_raster_step01_repair_image_model=
layering_raster_step03_image_model=
layering_clothing_raster_step01_image_model=
layering_clothing_raster_step02_image_model=
layering_clothing_raster_step01_review_image_model=
layering_clothing_raster_step01_repair_image_model=
layering_assembly_image_model=
layering_shadow_maps_image_model=
layering_nine_axis_view_image_model=

# 自定义 OpenAI 生图固定使用 Images API；base URL 通常包含 /v1，工具追加 /images/edits 或 /images/generations。
layering_openai_image_base_url=
layering_openai_image_api_key=

# 自定义 Google 生图：gemini 原生协议的 base URL 通常包含 /v1beta；openai 协议通常包含 /v1。
# gemini 追加 /models/<模型>:generateContent；openai 使用 Images API。
layering_google_image_base_url=
layering_google_image_api_key=
layering_google_image_protocol=gemini

# 旧 layering_<小步骤>_model 在同一职责的值一致时仍可读取；不一致时须填写对应统一键。
# layering_agent_<职责>_model 优先；旧 medium/high 默认及 image_base_url / api_key / model 仍可读取。

# 旧版单一生图接口的默认模型，仅在配置旧 image_base_url / api_key 时使用。
# 当前路线使用上面的 default_image_model 与各步骤 image_model。
layering_image_model=gpt-image-2.5-sunburst
