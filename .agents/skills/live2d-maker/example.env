# 默认模型配置的唯一来源：启动器创建 .env、运行时回退与 WebUI 默认展示均读取本文件。
# 方案 1（默认）：全 gpt-6.1-sol，按职责配置力度；生图继承 Codex 内置工具。
# 新安装直接以本文件创建 .env；方案 2 在此基础上叠加 presets/optimized.env。已有 .env 不整份覆盖。
# 非空 .env 配置优先于启动环境；留空表示未单独配置，回退到启动环境和默认值。同一来源内统一键优先于旧别名。不执行 shell 或展开变量。
# 内置模型预设：gpt-6.1-sol / gpt-6-astra -> codex；claude-sonnet-5-5 / claude-opus-5-5 / claude-haiku-5-5 -> claude；gemini-4-argon -> agv。
# 自定义语言模型 ID 先加入对应 CLI 的 models 列表，再用于职责模型配置。
# 最后一个后缀是思考力度：low / medium / high / xhigh。留空使用对应职责默认值。
# LLM 按职责配置，人物和衣服共用；生图按实际拥有工具的 agent 分别配置。
# Nano 透明后处理使用已有 Node／Sharp 双背景差分，不安装 Python 包或抠图模型。
# Python 优先复用宿主已有环境；缺少时由启动 agent 验证 Krita 内置脚本环境。

# 三种主模型 CLI 共用 key / URL / models；与下方生图接口分别鉴权。
# 连接字段留空复用已有登录／provider。Codex、Claude 只填 key 使用官方地址；AGV 需同时填 key 和 URL。
# models 按逗号分隔，支持 * 通配符；自定义列表追加到默认规则，不替换。具体模型仍由职责键选择。
# Codex 保留宿主模型元数据；Claude 写入请求私有 modelPicker；AGV 转成原生网关模型列表。均不改用户全局配置。
codex_api_key=
codex_base_url=https://api.openai.com/v1
codex_models=gpt-*
claude_api_key=
claude_base_url=https://api.anthropic.com
claude_models=claude-*
agv_api_key=
agv_base_url=
agv_models=gemini-*
# genai / openai；统一连接留空默认 genai。openai 暂不支持本项目的 AGV 图片容量保护。
agv_protocol=genai
# 例如 codex_models=gpt-6.1-sol,gpt-6-astra；claude_models=claude-sonnet-5-5,claude-opus-5-5。
# 旧 custom_provider=true + provider_base_url/api_key、ANTHROPIC_API_KEY/BASE_URL、
# AGY_LLM_GATEWAY_API_KEY/URL/MODELS/WIRE_PROTOCOL 仍兼容；新配置使用上面的统一键。

# 可选 CLI 绝对路径或相对 skill 的路径。Claude / agv 留空仅查找全局 PATH；不会自动安装。
# 仅作为 Codex 登录认证 auth.json 的来源；实际配置和会话数据放在管线 agents/ 内。
codex_home=
claude_path=
# true 时在首次使用 AGV 前自动准备补丁副本，取消原 CLI 60 秒的响应头期限，默认关闭；不安装 CLI，不需要 Rust。
agv_unlimited_response_header_timeout=false
# 原始 CLI 路径；也兼容已有 patch:agv 返回的受控入口。
# CLI 自动更新开关使用 true（不能使用 1）；不兼容或开关未生效会明确报错。
agv_path=
# 自定义 GenAI 网关拒绝 CLI 发出的 MINIMAL 时，可显式兼容为 LOW；默认留空，不修改任何力度。
# 仅替换 MINIMAL；支持 MINIMAL 的供应商保持留空。不会修改已经是 LOW / MEDIUM / HIGH 的请求。
agv_minimal_thinking_level=

# 仅 Codex：按当前上下文图片数 compact，留空关闭；如上游最多 50 张，可填 49。
# Codex 始终自动准备并复用管线补丁版。
# 缺 Rust 1.95.0 时自动在临时目录安装并在构建后清理；仍需 Git 和平台 C/C++ 编译依赖。
# 构建进度每 20～30 秒写入工作流日志；3 分钟无输出会提示可能的网络问题与处理办法，不会自动中止。
# 安装补丁本身不启用保护；pnpm env:check 检查生效值。换模型方案时保留已配置的阈值。
image_compact_threshold=

# 各接口独立的图片数／实际 JSON 请求体预算；留空关闭，不改变上游硬限制。
# Codex 专用阈值优先于旧 image_compact_threshold；按字节压缩需要新补丁 request_compaction_version: 1。
# 数量达到阈值或最终请求大小达到预算时带图 compact；溢出时每批也受同样预算约束。
codex_image_compact_threshold=
codex_request_compact_mib=
claude_image_compact_threshold=
claude_request_compact_mib=
agv_image_compact_threshold=
agv_request_compact_mib=
# 例如已确认 AGV 上游 100 MiB 时可填 80；Claude 官方 Messages 32 MB 时可填 28。
# AGV 保护需要已配置的 genai 网关；Claude 支持原生 Messages 路由，保留原鉴权和原生自动压缩。
# 可选无损去重默认关闭：匹配图片字节及来源／裁剪／倍率／模式，保留最新原图与所有文字／调用记录。
agv_image_deduplicate=false
claude_image_deduplicate=false

# 本机同时运行的 section Krita 上限，跨任务计算，须为正整数。需要 Krita 的 section 在动手前占一个名额并持有到
# section 结束；名额用满时在进入该 section 前排队，不需要 Krita 的 section 不占名额，也不给 agent krita 工具。
krita_max_instances=4

# 工作台每天最多查询一次 GitHub 最新发布标签，有新版本时在标题栏提示；只提示，不下载、不替换文件。
# false 关闭；留空或 true 开启。不影响任何制作步骤。
update_check=true

# Linux 图形环境；通常留空，使用启动环境中的显示服务和 Qt 后端。
DISPLAY=
WAYLAND_DISPLAY=
QT_QPA_PLATFORM=

# preparation 的全部 agent：姿态／画风判断、标准化、简化、素体和纯衣服准备。
preparation_agent_model=gpt-6.1-sol-low

# 两套 part 共用。返修沿用绘制模型，首次分组与细分组共用，深度分析单独配置。
part_draw_agent_model=gpt-6.1-sol-medium
part_review_agent_model=gpt-6.1-sol-medium
part_reduce_agent_model=gpt-6.1-sol-high
part_completion_agent_model=gpt-6.1-sol-high
part_groups_agent_model=gpt-6.1-sol-high
part_depth_agent_model=gpt-6.1-sol-high
# SVG 合并由程序完成，不配置 LLM。

# 两套 raster 共用。step01 reviewer 独立配置，返修沿用 step01；step03 仅人物有。
raster_step01_agent_model=gpt-6.1-sol-xhigh
raster_step02_agent_model=gpt-6.1-sol-medium
raster_step01_review_agent_model=gpt-6.1-sol-xhigh
raster_step03_agent_model=gpt-6.1-sol-medium

# 后续人物与衣服组装仍独立配置。
assembly_agent_model=gpt-6.1-sol-xhigh
# 投影蒙版与法线／深度共用阴影制作职责。
shadow_agent_model=gpt-6.1-sol-medium
# 头部九轴共用制作模型：脸部、头发与头饰步骤使用同一配置。
nine_axis_head_agent_model=gpt-6.1-sol-xhigh

# 生图预设：codex-native、GPT Image 2.5/2.6 Sunburst/Flare、gemini-nano-banana-2.1；也可输入自定义 ID。
# Nano 透明请求内部串行生图两次（首次生成、仅换背景），由 Sharp 差分恢复 alpha；不安装抠图模型。
# codex-native 直接继承宿主 imagegen，不启用生图补丁；仅能与 Codex 模型配对。
# Codex 选择 GPT / Nano 并填写对应 API 时统一走补丁版原生 imagegen；未指定路径时自动构建。
# Claude / AGV 选择 GPT / Nano 时注册共享 imagegen 工具，不需要 Codex 补丁。
# 生图能力以各步骤 agent.json 的 tools 是否包含 imagegen 为准；未声明的 agent 不读其生图模型配置。
# 每个拥有生图工具的 agent 可以单独选择，不合并人物与衣服的生图配置；留空继承默认。
default_image_model=codex-native
part_standardize_image_model=
part_simplify_image_model=
part_base_subject_image_model=
clothing_preparation_image_model=
part_completion_image_model=
clothing_completion_image_model=
raster_step01_image_model=
raster_step01_repair_image_model=
clothing_raster_step01_image_model=
clothing_raster_step01_repair_image_model=
shadow_maps_image_model=

# 自定义 OpenAI 生图固定使用 Images API；base URL 通常包含 /v1，工具追加 /images/edits 或 /images/generations。
openai_image_models=gpt-*
openai_image_base_url=
openai_image_api_key=

# 自定义 Google 生图：gemini 原生协议的 base URL 通常包含 /v1beta；openai 协议通常包含 /v1。
# gemini 追加 /models/<模型>:generateContent；openai 使用 Images API。
google_image_models=gemini-*,nano-banana-*
google_image_base_url=
google_image_api_key=
google_image_protocol=gemini

# 头部九轴首帧图生视频。provider：volcengine（火山官方，默认）/ openrouter / openai（含 LiteLLM）。
# 服务地址与密钥同时填写；不使用生图接口。仅九轴需要视频与 FFmpeg，CLI 用 --ffmpeg 指定。
# 地址示例：火山 https://ark.cn-beijing.volces.com/api/v3；OpenRouter https://openrouter.ai/api/v1。
video_provider=volcengine
video_base_url=
video_api_key=
# 可选预设或输入服务实际支持的 ID。OpenAI 兼容旧配置请显式设置 video_provider=openai。
nine_axis_view_video_model=doubao-seedance-2-5-260628

# 旧版带 layering_ 前缀的键名（如 layering_codex_api_key）仍按去掉前缀后的同一键读取，两者都填时以新键为准。
# 旧 layering_<小步骤>_model 在同一职责的值一致时仍可读取；不一致时须填写对应统一键。
# <职责>_agent_model 优先；旧 medium/high 默认及 image_base_url / api_key / model 仍可读取。

# 旧版单一生图接口的默认模型，仅在配置旧 image_base_url / api_key 时使用。
# 当前路线使用上面的 default_image_model 与各步骤 image_model。
image_model=gpt-image-2.5-sunburst
