;; Bulk version of the displacement sampler in nine-axis-model.js.
;; Keep f64 operations and their order: the only f32 rounding is the output.
;; Record: x0, y0, width, height (f64), cols, rows, smooth, data (i32).
(module
  (memory (export "memory") 32)
  (func $row (param $p i32) (param $s f64) (result f64)
    (f64.add (f64.load (local.get $p))
      (f64.mul (f64.mul (f64.const 0.5) (local.get $s))
        (f64.add (f64.load offset=8 (local.get $p))
          (f64.mul (local.get $s) (f64.add (f64.load offset=16 (local.get $p))
            (f64.mul (local.get $s) (f64.load offset=24 (local.get $p)))))))))
  (func $cubic (param $a f64) (param $b f64) (param $c f64) (param $d f64) (param $t f64) (result f64)
    (f64.add (local.get $b) (f64.mul (f64.mul (f64.const 0.5) (local.get $t))
      (f64.add (f64.sub (local.get $c) (local.get $a))
        (f64.mul (local.get $t) (f64.add
          (f64.sub (f64.add (f64.sub (f64.mul (f64.const 2) (local.get $a))
            (f64.mul (f64.const 5) (local.get $b))) (f64.mul (f64.const 4) (local.get $c))) (local.get $d))
          (f64.mul (local.get $t) (f64.sub (f64.add
            (f64.mul (f64.const 3) (f64.sub (local.get $b) (local.get $c))) (local.get $d)) (local.get $a)))))))))
  (func $component (param $r i32) (param $i i32) (param $j i32) (param $s f64) (param $t f64) (param $k i32) (result f64)
    (local $p i32) (local $step i32)
    (if (result f64) (i32.load offset=40 (local.get $r))
      (then
        (local.set $step (i32.mul (i32.load offset=32 (local.get $r)) (i32.const 64)))
        (local.set $p (i32.add (i32.load offset=44 (local.get $r))
          (i32.add (i32.add (i32.mul (local.get $j) (local.get $step)) (i32.mul (local.get $i) (i32.const 64)))
            (i32.mul (local.get $k) (i32.const 32)))))
        (call $cubic (call $row (local.get $p) (local.get $s))
          (call $row (i32.add (local.get $p) (local.get $step)) (local.get $s))
          (call $row (i32.add (local.get $p) (i32.mul (local.get $step) (i32.const 2))) (local.get $s))
          (call $row (i32.add (local.get $p) (i32.mul (local.get $step) (i32.const 3))) (local.get $s)) (local.get $t)))
      (else
        (local.set $step (i32.mul (i32.add (i32.load offset=32 (local.get $r)) (i32.const 3)) (i32.const 16)))
        (local.set $p (i32.add (i32.load offset=44 (local.get $r))
          (i32.add (i32.add (i32.mul (i32.add (local.get $j) (i32.const 1)) (local.get $step))
            (i32.mul (i32.add (local.get $i) (i32.const 1)) (i32.const 16))) (i32.mul (local.get $k) (i32.const 8)))))
        (f64.add
          (f64.mul (f64.add (f64.mul (f64.load (local.get $p)) (f64.sub (f64.const 1) (local.get $s)))
            (f64.mul (f64.load offset=16 (local.get $p)) (local.get $s))) (f64.sub (f64.const 1) (local.get $t)))
          (f64.mul (f64.add (f64.mul (f64.load (i32.add (local.get $p) (local.get $step))) (f64.sub (f64.const 1) (local.get $s)))
            (f64.mul (f64.load offset=16 (i32.add (local.get $p) (local.get $step))) (local.get $s))) (local.get $t))))))
  (func $apply (param $r i32) (param $x f64) (param $y f64) (result f64 f64)
    (local $cols f64) (local $rows f64) (local $u f64) (local $v f64) (local $i i32) (local $j i32) (local $s f64) (local $t f64)
    (local.set $cols (f64.convert_i32_s (i32.load offset=32 (local.get $r))))
    (local.set $rows (f64.convert_i32_s (i32.load offset=36 (local.get $r))))
    (local.set $u (f64.max (f64.const 0) (f64.min (local.get $cols)
      (f64.mul (f64.div (f64.sub (local.get $x) (f64.load (local.get $r))) (f64.load offset=16 (local.get $r))) (local.get $cols)))))
    (local.set $v (f64.max (f64.const 0) (f64.min (local.get $rows)
      (f64.mul (f64.div (f64.sub (local.get $y) (f64.load offset=8 (local.get $r))) (f64.load offset=24 (local.get $r))) (local.get $rows)))))
    (local.set $i (i32.trunc_f64_s (f64.min (f64.sub (local.get $cols) (f64.const 1)) (f64.floor (local.get $u)))))
    (local.set $j (i32.trunc_f64_s (f64.min (f64.sub (local.get $rows) (f64.const 1)) (f64.floor (local.get $v)))))
    (local.set $s (f64.sub (local.get $u) (f64.convert_i32_s (local.get $i))))
    (local.set $t (f64.sub (local.get $v) (f64.convert_i32_s (local.get $j))))
    (f64.add (local.get $x) (call $component (local.get $r) (local.get $i) (local.get $j) (local.get $s) (local.get $t) (i32.const 0)))
    (f64.add (local.get $y) (call $component (local.get $r) (local.get $i) (local.get $j) (local.get $s) (local.get $t) (i32.const 1))))
  (func $chain (param $p i32) (param $n i32) (param $x f64) (param $y f64) (result f64 f64)
    (block $done (loop $next
      (br_if $done (i32.le_s (local.get $n) (i32.const 0)))
      (call $apply (i32.load (local.get $p)) (local.get $x) (local.get $y))
      (local.set $y) (local.set $x)
      (local.set $p (i32.add (local.get $p) (i32.const 4)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br $next)))
    (local.get $x) (local.get $y))
  ;; Four chains: local, independent X, independent Y, current parents.
  ;; A -1 axis count means absent; an empty present axis still participates
  ;; in the original a + b - input floating-point expression.
  (func (export "run") (param $input i32) (param $output i32) (param $end i32)
    (param $l i32) (param $nl i32) (param $a i32) (param $na i32)
    (param $b i32) (param $nb i32) (param $p i32) (param $np i32)
    (local $x f64) (local $y f64) (local $ox f64) (local $oy f64) (local $ax f64) (local $ay f64)
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $input) (local.get $end)))
      (call $chain (local.get $l) (local.get $nl)
        (f64.promote_f32 (f32.load (local.get $input))) (f64.promote_f32 (f32.load offset=4 (local.get $input))))
      (local.set $y) (local.set $x)
      (if (i32.and (i32.ge_s (local.get $na) (i32.const 0)) (i32.ge_s (local.get $nb) (i32.const 0)))
        (then
          (local.set $ox (local.get $x)) (local.set $oy (local.get $y))
          (call $chain (local.get $a) (local.get $na) (local.get $x) (local.get $y))
          (local.set $ay) (local.set $ax)
          (call $chain (local.get $b) (local.get $nb) (local.get $ox) (local.get $oy))
          (local.set $y) (local.set $x)
          (local.set $x (f64.sub (f64.add (local.get $ax) (local.get $x)) (local.get $ox)))
          (local.set $y (f64.sub (f64.add (local.get $ay) (local.get $y)) (local.get $oy))))
        (else
          (call $chain (local.get $a) (local.get $na) (local.get $x) (local.get $y))
          (local.set $y) (local.set $x)
          (call $chain (local.get $b) (local.get $nb) (local.get $x) (local.get $y))
          (local.set $y) (local.set $x)))
      (call $chain (local.get $p) (local.get $np) (local.get $x) (local.get $y))
      (local.set $y) (local.set $x)
      (f32.store (local.get $output) (f32.demote_f64 (local.get $x)))
      (f32.store offset=4 (local.get $output) (f32.demote_f64 (local.get $y)))
      (local.set $input (i32.add (local.get $input) (i32.const 8)))
      (local.set $output (i32.add (local.get $output) (i32.const 8)))
      (br $next))))
)
