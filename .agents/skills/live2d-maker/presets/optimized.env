# 方案 2（混合方案，可选）：先以 example.env 为基础，再替换以下键；运行时只读取 skill 根目录 .env。
# 人物与衣服共用语言模型职责；覆盖方案 1 默认值，已有 .env 仅替换选定的键。
preparation_agent_model=gpt-6.1-sol-low
part_draw_agent_model=gpt-6.1-sol-xhigh
part_review_agent_model=gpt-6.1-sol-xhigh
part_reduce_agent_model=gpt-6.1-sol-xhigh
part_completion_agent_model=claude-sonnet-5-5-xhigh
part_groups_agent_model=gpt-6.1-sol-xhigh
part_depth_agent_model=gpt-6.1-sol-xhigh
raster_step01_agent_model=claude-opus-5-5-xhigh
raster_step01_review_agent_model=claude-sonnet-5-5-xhigh
raster_step02_agent_model=claude-sonnet-5-5-xhigh
raster_step03_agent_model=claude-sonnet-5-5-xhigh
assembly_agent_model=claude-sonnet-5-5-xhigh
shadow_agent_model=claude-sonnet-5-5-xhigh
nine_axis_head_agent_model=claude-sonnet-5-5-xhigh

# 简化图使用 Sunburst 原生透明背景；素体、两套 part 的遮挡补全参考使用 Nano，其余使用 Sunburst。
default_image_model=gpt-image-2.5-sunburst
clothing_preparation_image_model=gpt-image-2.5-sunburst
part_simplify_image_model=gpt-image-2.5-sunburst
part_base_subject_image_model=gemini-nano-banana-2.1
part_completion_image_model=gemini-nano-banana-2.1
clothing_completion_image_model=gemini-nano-banana-2.1
# 填写基础模板中的 OpenAI 与 Google 生图 API URL / key；Google 协议按服务选择 gemini 或 openai。
