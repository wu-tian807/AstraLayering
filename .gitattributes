# Keep the delivered options bytes consistent with its SHA-256 manifest.
demos/jianma-svg-ver/body-run/options.json text eol=lf

# Desktop launchers use their platform's expected line endings.
start-workbench.command text eol=lf
start-workbench.sh text eol=lf
start-workbench.cmd text eol=crlf

# Preserve recorded run artifacts byte-for-byte across platforms.
demos/jianma-svg-ver/body-run/refinement/** -text
demos/jianma-svg-ver/body-run/reviews/** -text
demos/jianma-svg-ver/body-run/tmp/** -text
demos/jianma-svg-ver/body-run/*.md -text
demos/jianma-svg-ver/clothing-run/** -text
rigging/milly/v3/video-work/** -text
demos/jianma/clothing-raster-layering/*.kra -text
demos/jianma/clothing-raster-layering/images/** -text

# Preserve reference sources, historical records and their recorded SHA-256 bytes.
tutorial/live2d-guidance/model-originals/** -text
tutorial/live2d-guidance/hair-reference-templates/** -text
tutorial/live2d-guidance/hair-reference-research-20261015/** -text
tutorial/live2d-guidance/finger-reference-materials/** -text
tutorial/live2d-guidance/layering-references.md -text
tutorial/live2d-guidance/layering-reference-inventory.json -text
tutorial/live2d-guidance/tools/verify_layering_references.py -text
tutorial/live2d-guidance/tools/verify_qq_mail_archives.py -text

# Jianma delivery images and SVGs preserve source bytes.
demos/jianma/**/*.kra -text
demos/jianma/**/*.png -text
demos/jianma/**/*.jpg -text
demos/jianma/**/*.svg -text

# A blank unified-diff context line is one required space.
.agents/skills/live2d-maker/patches/codex/*.patch text eol=lf whitespace=-blank-at-eol

# Pink Elf snapshot and its SHA-256 manifest preserve original bytes.
demos/pink-elf/** -text

# Tanuki reference keeps the authored KRA, model and texture bytes across platforms.
demos/tanuki-girl/** -text

# Closed-face archive and its SHA-256 manifest preserve exported bytes.
demos/closed-face-full-20261026/** -text

# Blue Uniform Girl archive and its SHA-256 manifest preserve exported bytes.
demos/blue-uniform-girl/** -text
# Keep the whitespace already present in the exported SVG artwork.
demos/blue-uniform-girl/**/*.svg whitespace=-blank-at-eol

# Preserve SAM verification artifacts and their recorded file hashes.
sam_veirfy/outputs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Release ZIP (git archive of a vX.Y.Z tag, see scripts/release-pack.mjs): the workbench, the skill,
# showcase images and one example task. History, research and the other archives stay on GitHub.
# scripts/release-pack.mjs maps the tagged Pink Doll tree into .run/pink-doll.
/archive export-ignore
/svg-previewer export-ignore
/rigging export-ignore
/sam_veirfy export-ignore
/tutorial export-ignore
/prompt.txt export-ignore
/demos export-ignore
