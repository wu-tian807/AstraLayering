# Local system and Python caches.
.DS_Store
__pycache__/
*.py[cod]
.options.yaml.lock
.options.json.lock

# Reinstall JavaScript dependencies from the saved package manifests.
node_modules/

# Tracing caches and trial renders stay local; retain the reconstruction seeds.
/demos/deep-sea-method-comparison/pixel-trace/work/*
!/demos/deep-sea-method-comparison/pixel-trace/work/part-seeds.json
/demos/deep-sea-method-comparison/structure-redraw/work/

# These generated HTML files embed another full copy of the SVG and reference.
# Recreate them with the preview scripts, or use svg-previewer/part-preview.html.
/demos/deep-sea-method-comparison/*/绘制过程.html

# Locally held third-party tutorial assets; existing tracked videos are preserved.
/tutorial/live2d-guidance/local-assets/
# Layering source models and original packages are versioned under tutorial.
# Temporary audit and incoming directories remain ignored.
/tutorial/live2d-guidance/model-originals/*
!/tutorial/live2d-guidance/model-originals/readme.md
!/tutorial/live2d-guidance/model-originals/manifest.json
!/tutorial/live2d-guidance/model-originals/milly/
!/tutorial/live2d-guidance/model-originals/lier/
!/tutorial/live2d-guidance/model-originals/cherry-cake-angel/
!/tutorial/live2d-guidance/model-originals/archives/
/tutorial/drawing-tutorial/*.mp4
!/tutorial/drawing-tutorial/画画的基本步骤.mp4
!/tutorial/drawing-tutorial/上色皮肤肉体的步骤.mp4
!/tutorial/drawing-tutorial/头发画法.mp4

# Scratch files and preview runtime from the Jianma Opus 5.5 workflow-next run.
/demos/jianma-svg-ver/opus55/tmp/
/demos/jianma-svg-ver/opus55/.runtime/
/demos/jianma-svg-ver/opus55/structure/*.lock

# Legacy task directories remain local.
/.agents/skills/*/
!/.agents/skills/live2d-maker/
# Runtime data is never versioned.
.run/

# Persistent web directory selection.
/.web/
