    "check:web": "tsc -p web/tsconfig.json",
    "physics": "node .agents/skills/live2d-maker/physics/run.ts",
    "physics:evidence": "node .agents/skills/live2d-maker/physics/evidence-cli.ts",
    "physics:probe": "node .agents/skills/live2d-maker/physics/initialization-probe.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@pixiv/three-vrm-materials-mtoon": "3.5.5",
    "ag-psd": "30.1.0",
    "fflate": "0.8.2",
    "playwright": "1.60.0",
    "sharp": "0.35.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "imports": {
    "#physics-core/*": "./.agents/skills/live2d-maker/shared/physics-core/*",
    "#physics-evidence/*": "./.agents/skills/live2d-maker/shared/physics-evidence/*",
